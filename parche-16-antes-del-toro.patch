+// Season 8: los bichos y NPC que este cliente no conoce por nombre.
+//
+// Esto TIENE que correr antes del switch de CreateMonster. Ese switch termina en
+// `case MONSTER_BULL_FIGHTER: ... default:`, o sea que **cualquier tipo desconocido sale como un
+// Bull Fighter** y deja c distinto de NULL, asi que los respaldos que estaban despues del switch
+// (la tabla del parche 11 y los modelos de NPC del parche 14) no llegaban a ejecutarse nunca.
+// Comprobado con el diagnostico del parche 15 en la prueba del 16-09: los tipos 581, 582, 583,
+// 589, 590 y 591 salian todos con el modelo 644, que es MODEL_BULL_FIGHTER.
+static CHARACTER* CreateSeason8Character(EMonsterType Type, int PositionX, int PositionY, int Key)
+{
+    CHARACTER* c = NULL;
+    const int TipoInt = static_cast<int>(Type);
+
+    // Los NPC de Acheron tienen modelo propio por nombre, en Data\\Npc\\Akeron\\ y Data\\Npc\\.
+    int AcheronNpc = 0;
+    switch (TipoInt)
+    {
+    case 580: AcheronNpc = MODEL_ACHERON_NPC_SLOPE; break;
+    case 581: AcheronNpc = MODEL_ACHERON_NPC_DERUVISH; break;
+    case 582: AcheronNpc = MODEL_ACHERON_NPC_ADNIEL; break;
+    case 583: AcheronNpc = MODEL_ACHERON_NPC_JINN; break;
+    case 584: AcheronNpc = MODEL_ACHERON_NPC_LESNAR; break;
+    default: break;
+    }
+
+    if (AcheronNpc != 0)
+    {
+        OpenNpc(AcheronNpc);
+        if (Models[AcheronNpc].NumMeshs > 0)
+        {
+            c = CreateCharacter(Key, AcheronNpc, PositionX, PositionY);
+            if (c != NULL)
+            {
+                c->Object.Kind = KIND_NPC;
+                c->Object.Scale = 1.0f;
+                g_ErrorReport.Write(L"Season 8: NPC tipo %d con su modelo propio %d\r\n", TipoInt, AcheronNpc);
+            }
+        }
+        else
+        {
+            g_ErrorReport.Write(L"Season 8: el modelo del NPC tipo %d no cargo\r\n", TipoInt);
+        }
 
+        return c;
+    }
+
+    // El resto sale de Data\\Local\\ExtraMonsters.txt (parche 11).
+    int ExtraModel = 0;
+    float ExtraScale = 1.0f;
+    if (GetExtraMonsterModel(TipoInt, &ExtraModel, &ExtraScale) == true)
+    {
+        OpenMonsterModelExtra(ExtraModel);
+
+        const int ExtraIndex = static_cast<int>(MODEL_MONSTER01) + ExtraModel;
+        if (Models[ExtraIndex].NumMeshs > 0)
+        {
+            c = CreateCharacter(Key, ExtraIndex, PositionX, PositionY);
+            if (c != NULL)
+            {
+                c->Object.Scale = ExtraScale;
+            }
+        }
+        else
+        {
+            g_ErrorReport.Write(L"Season 8: el modelo %d del bicho tipo %d no tiene mallas\r\n", ExtraModel, TipoInt);
+        }
+    }
+
+    return c;
+}
