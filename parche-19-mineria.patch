+// -----------------------------------------------------------------------------
+// Season 8: mineria Jewel of Pandora, lado del cliente.
+//
+// El servidor lleva toda la cuenta; aqui solo se manda el golpe, se contesta al cartel y se pintan
+// el numero flotante y los mensajes. El estado que se guarda es el minimo para poder contestar:
+// que veta es y en que fase va, porque el cartel no lleva esa informacion encima.
+// -----------------------------------------------------------------------------
+PandoraMiningState g_PandoraMining = { 0, 0, 0, 0, 0, false };
+
+void ResetPandoraMiningState()
+{
+    g_PandoraMining.ZoneId = 0;
+    g_PandoraMining.ZoneClass = 0;
+    g_PandoraMining.MapNumber = 0;
+    g_PandoraMining.Stage = 0;
+    g_PandoraMining.JewelCount = 0;
+    g_PandoraMining.Active = false;
+}
+
+// Este cliente no arma paquetes salientes en C++: todo pasa por la libreria .NET, que saca las
+// funciones de envio de un NuGet de OpenMU. El C1:4C es nuestro y no esta en ese paquete, asi que
+// se manda por la via cruda, que existe y esta exportada: ConnectionManager_Send. El lado
+// administrado rellena el byte de tamano con SetPacketSize antes de escribir al socket.
+static void PandoraSendRaw(const void* Packet, int Size)
+{
+    if (SocketClient == nullptr || !SocketClient->IsConnected())
+        return;
+
+    SocketClient->Send(reinterpret_cast<const BYTE*>(Packet), Size);
+}
+
+void SendPandoraMineRequest(WORD ZoneId, WORD ZoneClass)
+{
+    PMSG_PANDORA_MINE_REQ msg = {};
+    msg.h.m_Header.Code = 0xC1;
+    msg.h.m_Header.Size = sizeof(msg);
+    msg.h.m_Header.HeadCode = 0x4C;
+    msg.h.m_bySubCode = 0x00;
+
+    const WORD HeroId = (WORD)Hero->Key;
+    msg.PlayerIdH = HIBYTE(HeroId);       msg.PlayerIdL = LOBYTE(HeroId);
+    msg.ZoneIdH = HIBYTE(ZoneId);         msg.ZoneIdL = LOBYTE(ZoneId);
+    msg.ZoneClassH = HIBYTE(ZoneClass);   msg.ZoneClassL = LOBYTE(ZoneClass);
+    msg.MapNumber = (BYTE)gMapManager.WorldActive;
+
+    // Si se cambia de veta, la cadena empieza de cero.
+    if (!g_PandoraMining.Active || g_PandoraMining.ZoneId != ZoneId)
+    {
+        ResetPandoraMiningState();
+        g_PandoraMining.ZoneId = ZoneId;
+        g_PandoraMining.ZoneClass = ZoneClass;
+        g_PandoraMining.MapNumber = msg.MapNumber;
+        g_PandoraMining.Active = true;
+    }
+
+    msg.Stage = g_PandoraMining.Stage;
+
+    PandoraSendRaw(&msg, sizeof(msg));
+    g_ConsoleDebug->Write(MCD_SEND, L"0x4C:00 [SendPandoraMineRequest(zona %u clase %u fase %u)]",
+                          ZoneId, ZoneClass, msg.Stage);
+}
+
+void SendPandoraRewardRequest(bool CashOut)
+{
+    if (!g_PandoraMining.Active)
+        return;
+
+    PMSG_PANDORA_REWARD_REQ msg = {};
+    msg.h.m_Header.Code = 0xC1;
+    msg.h.m_Header.Size = sizeof(msg);
+    msg.h.m_Header.HeadCode = 0x4C;
+    msg.h.m_bySubCode = 0x01;
+
+    const WORD HeroId = (WORD)Hero->Key;
+    msg.PlayerIdH = HIBYTE(HeroId);                          msg.PlayerIdL = LOBYTE(HeroId);
+    msg.ZoneIdH = HIBYTE(g_PandoraMining.ZoneId);            msg.ZoneIdL = LOBYTE(g_PandoraMining.ZoneId);
+    msg.ZoneClassH = HIBYTE(g_PandoraMining.ZoneClass);      msg.ZoneClassL = LOBYTE(g_PandoraMining.ZoneClass);
+    msg.MapNumber = g_PandoraMining.MapNumber;
+    msg.Stage = g_PandoraMining.Stage;
+    msg.CashOut = CashOut ? 1 : 0;
+
+    PandoraSendRaw(&msg, sizeof(msg));
+    g_ConsoleDebug->Write(MCD_SEND, L"0x4C:01 [SendPandoraRewardRequest(cobrar %d)]", msg.CashOut);
+}
+
+void SendPandoraEndRequest()
+{
+    if (!g_PandoraMining.Active)
+        return;
+
+    PMSG_PANDORA_END_REQ msg = {};
+    msg.h.m_Header.Code = 0xC1;
+    msg.h.m_Header.Size = sizeof(msg);
+    msg.h.m_Header.HeadCode = 0x4C;
+    msg.h.m_bySubCode = 0x03;
+
+    const WORD HeroId = (WORD)Hero->Key;
+    msg.PlayerIdH = HIBYTE(HeroId);                msg.PlayerIdL = LOBYTE(HeroId);
+    msg.ZoneIdH = HIBYTE(g_PandoraMining.ZoneId);  msg.ZoneIdL = LOBYTE(g_PandoraMining.ZoneId);
+    msg.MapNumber = g_PandoraMining.MapNumber;
+
+    PandoraSendRaw(&msg, sizeof(msg));
+    g_ConsoleDebug->Write(MCD_SEND, L"0x4C:03 [SendPandoraEndRequest()]");
+    ResetPandoraMiningState();
+}
+
+// El numero amarillo flotante sobre la veta. Es la misma funcion que pinta los numeros de dano.
+static void PandoraShowJewelCount(WORD ZoneId, int JewelCount)
+{
+    if (JewelCount <= 0)
+        return;
+
+    const int Index = FindCharacterIndex(ZoneId);
+    if (Index < 0 || Index >= MAX_CHARACTERS_CLIENT)
+        return;
+
+    vec3_t Color;
+    Vector(1.f, 1.f, 0.2f, Color);
+    CreatePoint(CharactersClient[Index].Object.Position, JewelCount, Color, 25.f, true, false);
+}
+
+static void PandoraShowResultMessage(uint32_t Result)
+{
+    const wchar_t* Texto = nullptr;
+    SEASON3B::MESSAGE_TYPE Tipo = SEASON3B::TYPE_ERROR_MESSAGE;
+
+    switch (Result)
+    {
+    case PANDORA_RESULT_OK:
+        Texto = I18N::Game::PandoraMiningSuccess;
+        Tipo = SEASON3B::TYPE_SYSTEM_MESSAGE;
+        break;
+    case PANDORA_RESULT_OK_FINAL:
+        Texto = I18N::Game::PandoraMiningRewardReceived;
+        Tipo = SEASON3B::TYPE_SYSTEM_MESSAGE;
+        break;
+    case PANDORA_RESULT_FAILED:       Texto = I18N::Game::PandoraMiningFailed; break;
+    case PANDORA_RESULT_IN_USE:       Texto = I18N::Game::PandoraMiningZoneInUse; break;
+    case PANDORA_RESULT_TRANSFORMED:  Texto = I18N::Game::PandoraMiningTransformed; break;
+    case PANDORA_RESULT_NO_SPACE:     Texto = I18N::Game::PandoraMiningNoSpace; break;
+    case PANDORA_RESULT_BUSY:         Texto = I18N::Game::PandoraMiningBusy; break;
+    case PANDORA_RESULT_STORE:        Texto = I18N::Game::PandoraMiningPrivateStore; break;
+    case PANDORA_RESULT_NO_PICK:      Texto = I18N::Game::PandoraMiningNoDurability; break;
+    case PANDORA_RESULT_MISMATCH:     Texto = nullptr; break;   // antitrampas: no se le dice nada
+    default:                          Texto = nullptr; break;
+    }
+
+    if (Texto != nullptr)
+        g_pSystemLogBox->AddText(Texto, Tipo);
+}
+
+// GC[0xC1][0x4C][0x00]
+void ReceivePandoraMineResult(std::span<const BYTE> ReceiveBuffer)
+{
+    auto Data = safe_cast<PMSG_PANDORA_MINE_ANS>(ReceiveBuffer, "PandoraMineResult");
+    if (Data == nullptr)
+        return;
+
+    const WORD ZoneId = ((WORD)Data->ZoneIdH << 8) + Data->ZoneIdL;
+    const WORD ZoneClass = ((WORD)Data->ZoneClassH << 8) + Data->ZoneClassL;
+    const uint32_t JewelCount = PandoraReadUInt32(Data->JewelCount);
+    const uint32_t Result = PandoraReadUInt32(Data->Result);
+
+    g_ConsoleDebug->Write(MCD_RECEIVE, L"0x4C:00 [PandoraMineResult(zona %u fase %u joyas %u res %u)]",
+                          ZoneId, Data->Stage, JewelCount, Result);
+
+    PandoraShowResultMessage(Result);
+
+    if (Result == PANDORA_RESULT_OK || Result == PANDORA_RESULT_OK_FINAL)
+    {
+        g_PandoraMining.ZoneId = ZoneId;
+        g_PandoraMining.ZoneClass = ZoneClass;
+        g_PandoraMining.MapNumber = Data->MapNumber;
+        g_PandoraMining.Stage = Data->Stage;
+        g_PandoraMining.JewelCount = (int)JewelCount;
+        g_PandoraMining.Active = true;
+
+        PandoraShowJewelCount(ZoneId, (int)JewelCount);
+    }
+
+    if (Result == PANDORA_RESULT_OK)
+    {
+        // Fases 1 a 4: el jugador elige entre cobrar y seguir.
+        SEASON3B::CNewUICommonMessageBox* pMsgBox = nullptr;
+        SEASON3B::CreateMessageBox(MSGBOX_LAYOUT_CLASS(SEASON3B::CPandoraMiningMsgBoxLayout), &pMsgBox);
+        if (pMsgBox != nullptr)
+        {
+            wchar_t texto[160];
+            mu_swprintf(texto, I18N::Game::PandoraMiningJewelsSoFar, (int)JewelCount);
+            pMsgBox->AddMsg(texto, RGBA(255, 255, 255, 255), SEASON3B::MSGBOX_FONT_BOLD);
+            pMsgBox->AddMsg(L" ");
+            pMsgBox->AddMsg(I18N::Game::PandoraMiningPickUpQuestion, RGBA(255, 255, 255, 255),
+                            SEASON3B::MSGBOX_FONT_NORMAL);
+        }
+    }
+    else if (Result != PANDORA_RESULT_OK_FINAL)
+    {
+        // Cualquier otro resultado corta la cadena; la fase 5 la cierra el propio servidor.
+        ResetPandoraMiningState();
+    }
+    else
+    {
+        ResetPandoraMiningState();
+    }
+}
+
+// GC[0xC1][0x4C][0x01]
+void ReceivePandoraRewardResult(std::span<const BYTE> ReceiveBuffer)
+{
+    auto Data = safe_cast<PMSG_PANDORA_REWARD_ANS>(ReceiveBuffer, "PandoraRewardResult");
+    if (Data == nullptr)
+        return;
+
+    const uint32_t Result = PandoraReadUInt32(Data->Result);
+    g_ConsoleDebug->Write(MCD_RECEIVE, L"0x4C:01 [PandoraRewardResult(res %u)]", Result);
+
+    if (Result == PANDORA_RESULT_OK)
+    {
+        g_pSystemLogBox->AddText(I18N::Game::PandoraMiningRewardReceived, SEASON3B::TYPE_SYSTEM_MESSAGE);
+        ResetPandoraMiningState();
+    }
+    else
+    {
+        PandoraShowResultMessage(Result);
+        if (Result != PANDORA_RESULT_NO_SPACE)
+            ResetPandoraMiningState();
+    }
+}
+
 static void ProcessPacket(const BYTE* ReceiveBuffer, int32_t Size)
 {
     auto received_span = std::span<const BYTE>(ReceiveBuffer, Size);
@@ -14955,6 +15184,31 @@ static void ProcessPacket(const BYTE* ReceiveBuffer, int32_t Size)
     case 0x4B:
         ReceiveDarkside(ReceiveBuffer);
         break;
+    // Season 8: mineria Jewel of Pandora.
+    case 0x4C:
+    {
+        int subcode;
+        if (bIsC1C3)
+        {
+            auto Data = (LPPHEADER_DEFAULT_SUBCODE)ReceiveBuffer;
+            subcode = Data->SubCode;
+        }
+        else
+        {
+            auto Data = (LPPHEADER_DEFAULT_SUBCODE_WORD)ReceiveBuffer;
+            subcode = Data->SubCode;
+        }
+        switch (subcode)
+        {
+        case 0x00:
+            ReceivePandoraMineResult(received_span);
+            break;
+        case 0x01:
+            ReceivePandoraRewardResult(received_span);
+            break;
+        }
+    }
+    break;
     case 0xAE:
         // Received mu helper config from server
         ReceiveMuHelperConfigurationData(received_span);
