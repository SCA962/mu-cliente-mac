+// Los tamanos son los del S8, y si alguien mueve un campo la compilacion lo dice aqui y no en juego.
+static_assert(sizeof(PMSG_PANDORA_MINE_REQ) == 12, "PMSG_PANDORA_MINE_REQ debe medir 12 bytes");
+static_assert(sizeof(PMSG_PANDORA_REWARD_REQ) == 13, "PMSG_PANDORA_REWARD_REQ debe medir 13 bytes");
+static_assert(sizeof(PMSG_PANDORA_END_REQ) == 9, "PMSG_PANDORA_END_REQ debe medir 9 bytes");
+static_assert(sizeof(PMSG_PANDORA_MINE_ANS) == 20, "PMSG_PANDORA_MINE_ANS debe medir 20 bytes");
+static_assert(sizeof(PMSG_PANDORA_REWARD_ANS) == 16, "PMSG_PANDORA_REWARD_ANS debe medir 16 bytes");
+
+// Codigos de iResult. Son los del cliente original del S8: sus cadenas mapean uno a uno con ellos.
+enum EPandoraMiningResult
+{
+    PANDORA_RESULT_OK = 0,             // acierto de fase 1 a 4, se abre el cartel
+    PANDORA_RESULT_OK_FINAL = 1,       // acierto de la fase 5, se cobra solo
+    PANDORA_RESULT_FAILED = 2,         // fallo: se pierde todo lo acumulado
+    PANDORA_RESULT_IN_USE = 3,         // la veta la esta usando otro
+    PANDORA_RESULT_TRANSFORMED = 10,   // estas transformado
+    PANDORA_RESULT_NO_SPACE = 11,      // no caben las joyas en el inventario
+    PANDORA_RESULT_BUSY = 12,          // comerciando o comprando
+    PANDORA_RESULT_STORE = 13,         // tienda personal abierta
+    PANDORA_RESULT_MISMATCH = 17,      // la fase o la veta no cuadran con el servidor
+    PANDORA_RESULT_NO_PICK = 18,       // sin pico, o sin durabilidad suficiente
+};
+
+// Estado de la cadena de mineria en la que esta el jugador ahora mismo. Vive solo mientras dura la
+// cadena; el servidor manda la fase en cada respuesta, asi que esto es solo para poder contestar al
+// cartel y para saber a que veta se refiere.
+struct PandoraMiningState
+{
+    WORD ZoneId;
+    WORD ZoneClass;
+    BYTE MapNumber;
+    BYTE Stage;
+    int  JewelCount;
+    bool Active;
+};
+
+extern PandoraMiningState g_PandoraMining;
+
+void SendPandoraMineRequest(WORD ZoneId, WORD ZoneClass);
+void SendPandoraRewardRequest(bool CashOut);
+void SendPandoraEndRequest();
+void ResetPandoraMiningState();
+
+// Lee un entero de 4 bytes en big endian, que es como viajan en este protocolo.
+inline uint32_t PandoraReadUInt32(const BYTE* p)
+{
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | (uint32_t)p[3];
+}
