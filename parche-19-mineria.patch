+// -----------------------------------------------------------------------------
+// Season 8: cartel de la mineria Jewel of Pandora.
+//
+// Es el cartel de OK/Cancelar de siempre, no uno nuevo: los rotulos de los botones son texturas y
+// no se pueden cambiar sin escribir una clase entera aparte, asi que el significado va en el texto
+// del cuerpo, que lo pone quien abre el cartel porque lleva el numero de joyas del servidor.
+// Escape cuenta como cancelar, o sea seguir minando, que es la opcion que no pierde nada.
+// -----------------------------------------------------------------------------
+bool SEASON3B::CPandoraMiningMsgBoxLayout::SetLayout()
+{
+    CNewUICommonMessageBox* pMsgBox = GetMsgBox();
+    if (0 == pMsgBox)
+        return false;
+    if (false == pMsgBox->Create(MSGBOX_COMMON_TYPE_OKCANCEL))
+        return false;
+
+    pMsgBox->AddCallbackFunc(CPandoraMiningMsgBoxLayout::OkBtnDown, MSGBOX_EVENT_USER_COMMON_OK);
+    pMsgBox->AddCallbackFunc(CPandoraMiningMsgBoxLayout::CancelBtnDown, MSGBOX_EVENT_USER_COMMON_CANCEL);
+
+    pMsgBox->AddCallbackFunc(CPandoraMiningMsgBoxLayout::OkBtnDown, MSGBOX_EVENT_PRESSKEY_RETURN);
+    pMsgBox->AddCallbackFunc(CPandoraMiningMsgBoxLayout::CancelBtnDown, MSGBOX_EVENT_PRESSKEY_ESC);
+    return true;
+}
+
+CALLBACK_RESULT SEASON3B::CPandoraMiningMsgBoxLayout::OkBtnDown(class CNewUIMessageBoxBase* pOwner, const leaf::xstreambuf& xParam)
+{
+    SendPandoraRewardRequest(true);
+
+    PlayBuffer(SOUND_CLICK01);
+    g_MessageBox->SendEvent(pOwner, MSGBOX_EVENT_DESTROY);
+
+    return CALLBACK_BREAK;
+}
+
+CALLBACK_RESULT SEASON3B::CPandoraMiningMsgBoxLayout::CancelBtnDown(class CNewUIMessageBoxBase* pOwner, const leaf::xstreambuf& xParam)
+{
+    SendPandoraRewardRequest(false);
+
+    PlayBuffer(SOUND_CLICK01);
+    g_MessageBox->SendEvent(pOwner, MSGBOX_EVENT_DESTROY);
+
+    return CALLBACK_BREAK;
+}
