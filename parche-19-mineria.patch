+// -----------------------------------------------------------------------------
+// Season 8: mineria Jewel of Pandora, cabecera C1 / 0x4C.
+//
+// Mismos campos y mismos tamanos que las estructuras del cliente original del S8 (12, 13 y 9 bytes
+// de ida; 20 y 16 de vuelta), para que el protocolo sea el de verdad y no uno nuestro.
+// Los numeros de mas de un byte van en big endian, que es lo que manda el protocolo de MU y lo que
+// hace el resto de este fichero: se declaran como bytes sueltos y se componen a mano.
+// -----------------------------------------------------------------------------
+#pragma pack(push, 1)
+
+// CG[0xC1][0x4C][0x00]  golpe de mineria
+typedef struct
+{
+    PBMSG_HEADER2 h;
+    BYTE PlayerIdH;    BYTE PlayerIdL;
+    BYTE ZoneIdH;      BYTE ZoneIdL;
+    BYTE ZoneClassH;   BYTE ZoneClassL;
+    BYTE MapNumber;
+    BYTE Stage;
+} PMSG_PANDORA_MINE_REQ, * LPPMSG_PANDORA_MINE_REQ;
+
+// CG[0xC1][0x4C][0x01]  respuesta al cartel: cobrar o seguir
+typedef struct
+{
+    PBMSG_HEADER2 h;
+    BYTE PlayerIdH;    BYTE PlayerIdL;
+    BYTE ZoneIdH;      BYTE ZoneIdL;
+    BYTE ZoneClassH;   BYTE ZoneClassL;
+    BYTE MapNumber;
+    BYTE Stage;
+    BYTE CashOut;
+} PMSG_PANDORA_REWARD_REQ, * LPPMSG_PANDORA_REWARD_REQ;
+
+// CG[0xC1][0x4C][0x03]  el jugador abandona la veta
+typedef struct
+{
+    PBMSG_HEADER2 h;
+    BYTE PlayerIdH;    BYTE PlayerIdL;
+    BYTE ZoneIdH;      BYTE ZoneIdL;
+    BYTE MapNumber;
+} PMSG_PANDORA_END_REQ, * LPPMSG_PANDORA_END_REQ;
+
+// GC[0xC1][0x4C][0x00]  resultado del golpe
+typedef struct
+{
+    PBMSG_HEADER2 h;
+    BYTE PlayerIdH;    BYTE PlayerIdL;
+    BYTE ZoneIdH;      BYTE ZoneIdL;
+    BYTE ZoneClassH;   BYTE ZoneClassL;
+    BYTE MapNumber;
+    BYTE Stage;
+    BYTE JewelCount[4];
+    BYTE Result[4];
+} PMSG_PANDORA_MINE_ANS, * LPPMSG_PANDORA_MINE_ANS;
+
+// GC[0xC1][0x4C][0x01]  resultado del cobro
+typedef struct
+{
+    PBMSG_HEADER2 h;
+    BYTE PlayerIdH;    BYTE PlayerIdL;
+    BYTE ZoneIdH;      BYTE ZoneIdL;
+    BYTE ZoneClassH;   BYTE ZoneClassL;
+    BYTE MapNumber;
+    BYTE Stage;
+    BYTE Result[4];
+} PMSG_PANDORA_REWARD_ANS, * LPPMSG_PANDORA_REWARD_ANS;
+
+#pragma pack(pop)
