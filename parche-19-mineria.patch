+// Season 8: el parpadeo de una zona de mineria de la Jewel of Pandora.
+//
+// Las zonas no tienen modelo (ver CreateSeason8Character), asi que lo unico que se ve de ellas es
+// esto. Es la misma receta de la farola de Lorencia (ZzzObject.cpp, MODEL_STREET_LIGHT): la
+// luminosidad al azar en cada fotograma ES el parpadeo. El radio de la luz y el color cambian con
+// el tamano de la zona, que en el original son azul, morada y dorada.
+static void MovePandoraMiningZone(CHARACTER* c, OBJECT* o)
+{
+    const int TipoInt = static_cast<int>(c->MonsterIndex);
+    if (TipoInt < PANDORA_ZONE_SMALL || TipoInt > PANDORA_ZONE_LARGE)
+        return;
+
+    const int Radio = 2 + (TipoInt - PANDORA_ZONE_SMALL);
+    const float Luminosity = (float)(rand() % 6 + 5) * 0.1f;
+
+    vec3_t Light;
+    switch (TipoInt)
+    {
+    case PANDORA_ZONE_SMALL:
+        Vector(Luminosity * 0.35f, Luminosity * 0.65f, Luminosity, Light);
+        break;
+    case PANDORA_ZONE_MEDIUM:
+        Vector(Luminosity * 0.75f, Luminosity * 0.30f, Luminosity, Light);
+        break;
+    default:
+        Vector(Luminosity, Luminosity * 0.85f, Luminosity * 0.25f, Light);
+        break;
+    }
+
+    AddTerrainLight(o->Position[0], o->Position[1], Light, Radio, PrimaryTerrainLight);
+
+    // Y unas particulas subiendo, para que se vea desde lejos. Menos a menudo cuanto mas chica.
+    if (rand_fps_check(4))
+    {
+        const float Dispersion = 20.f * (float)Radio;
+        vec3_t Position;
+        VectorCopy(o->Position, Position);
+        Position[0] += (float)(rand() % 200 - 100) * 0.01f * Dispersion;
+        Position[1] += (float)(rand() % 200 - 100) * 0.01f * Dispersion;
+        Position[2] += 10.f;
+        CreateParticle(BITMAP_LIGHT, Position, o->Angle, Light, 0, 0.8f);
+    }
+}
