+// Una casilla puede pedir una textura que la Data del mapa no trae: Acheron usa el indice 12
+// (TileRock06) en dos casillas y ese fichero no viene ni en el cliente S8 original, y Debenter usa
+// el 20 (ExtTile07) en otras dos. Cuando eso pasa, Bitmaps[...].Width vale 0: el ancho de textura
+// sale de una division por cero, las coordenadas quedan infinitas y la casilla se dibuja como un
+// plano gris que ademas arrastra a lo que se pinte despues. Se cae a la primera textura del mapa,
+// que siempre esta cargada, y se deja constancia una vez por indice.
+static int SafeTileTexture(int Texture)
+{
+    if (Texture >= 0 && Bitmaps[BITMAP_MAPTILE + Texture].Width > 0)
+        return Texture;
+
+    static bool s_Avisado[256] = {};
+    if (Texture >= 0 && Texture < 256 && s_Avisado[Texture] == false)
+    {
+        s_Avisado[Texture] = true;
+        g_ErrorReport.Write(L"Terreno: el mundo %d pide la textura de casilla %d y no esta cargada\r\n",
+                            gMapManager.WorldActive, Texture);
+    }
+
+    return 0;
+}
